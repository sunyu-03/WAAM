        "cwd": "${workspaceFolder}",
        "name": "WAAM PPO: 작은 모델 학습 + 공식 검증"
      },
      {
        "request": "launch",
        "console": "integratedTerminal",
        "args": [
          "--dataset",
          "${workspaceFolder}/integration/evidence/routes_20261009_001/inputs/dataset.json",
