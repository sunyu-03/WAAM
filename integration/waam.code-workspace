  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "WAAM: Model 01 공식 검증",
        "type": "debugpy",
        "request": "launch",
        "python": "C:/Users/User/Desktop/WAAM_Validator-main/.venv/Scripts/python.exe",
        "program": "${workspaceFolder}/integration/run_pipeline.py",
