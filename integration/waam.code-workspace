      },
      {
        "program": "${workspaceFolder}/integration/train.py",
        "python": "C:/Users/User/Desktop/WAAM_Validator-main/.venv/Scripts/python.exe",
        "request": "launch",
        "console": "integratedTerminal",
        "type": "debugpy",
        "args": [
          "--job",
          "${workspaceFolder}/TEAM_PROJECT/week1/environment/examples/sample_job",
          "--demo-segments",
          "8",
          "--timesteps",
          "8192",
